# Copy to .env for local use. On Vercel, set these in Project Settings > Environment Variables.

# Manager page: choose a long random path and password. Neither goes in the repository.
ADMIN_PATH=
ADMIN_TOKEN=

# Upstash Redis. Vercel's Upstash integration fills in the KV_ names for you.
# Leave empty locally to store reviews in server/data/reviews.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Only when running server/index.mjs behind your own reverse proxy.
# TRUST_PROXY=true
